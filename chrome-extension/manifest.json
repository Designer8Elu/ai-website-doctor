{
  "manifest_version": 3,
  "name": "AI Website Doctor",
  "description": "Run the Website Doctor audit directly from Chrome on the current tab.",
  "version": "1.0.0",
  "action": {
    "default_title": "AI Website Doctor Audit",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://ai-website-doctor.vercel.app/*",
    "https://*/*"
  ]
}
